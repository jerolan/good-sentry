publish	Build and publish both architectures	2026-10-21T06:04:19.5852590Z             "display_title": "Fix Mach-O dSYM image base resolution",
publish	Build and publish both architectures	2026-10-21T06:04:19.5852929Z             "event": "push",
publish	Build and publish both architectures	2026-10-21T06:04:19.5853167Z             "head_branch": "main",
