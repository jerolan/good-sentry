publish	Build and publish both architectures	2026-10-21T06:04:19.5855146Z               "committer": {
publish	Build and publish both architectures	2026-10-21T06:04:19.5855438Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T06:04:19.5855763Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T06:04:19.5856004Z               },
publish	Build and publish both architectures	2026-10-21T06:04:19.5856241Z               "id": "0ae6c9d26c56f306e1b61383614b655753d43311",
publish	Build and publish both architectures	2026-10-21T06:04:19.5858354Z               "message": "Fix Mach-O dSYM image base resolution\n\nMach-O dSYM companion files can carry an executable __TEXT segment with no file-backed bytes and a separate __DWARF segment at a different address. Selecting the first file-backed segment made every DWARF address appear below the image base, so the object silently produced no symbols.\n\nPrefer the __TEXT load command and fall back to the lowest non-page-zero mapped segment. Cover the parser and the HTTP Minidump plus Debug-ID path with an actual dSYM companion fixture, while retaining the ELF regression.",
publish	Build and publish both architectures	2026-10-21T06:04:19.5860478Z               "timestamp": "2026-10-21T05:57:36Z",
