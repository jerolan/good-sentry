publish	Build and publish both architectures	2026-10-21T06:04:19.6047056Z             "created_at": "2026-10-21T05:57:45Z",
publish	Build and publish both architectures	2026-10-21T06:04:19.6047402Z             "display_title": "Fix Mach-O dSYM image base resolution",
publish	Build and publish both architectures	2026-10-21T06:04:19.6047743Z             "event": "push",
publish	Build and publish both architectures	2026-10-21T06:04:19.6047976Z             "head_branch": "main",
publish	Build and publish both architectures	2026-10-21T06:04:19.6048221Z             "head_commit": {
publish	Build and publish both architectures	2026-10-21T06:04:19.6048451Z               "author": {
publish	Build and publish both architectures	2026-10-21T06:04:19.6048727Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T06:04:19.6049057Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T06:04:19.6049314Z               },
publish	Build and publish both architectures	2026-10-21T06:04:19.6049507Z               "committer": {
publish	Build and publish both architectures	2026-10-21T06:04:19.6049785Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T06:04:19.6050109Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T06:04:19.6050353Z               },
publish	Build and publish both architectures	2026-10-21T06:04:19.6050593Z               "id": "0ae6c9d26c56f306e1b61383614b655753d43311",
publish	Build and publish both architectures	2026-10-21T06:04:19.6052702Z               "message": "Fix Mach-O dSYM image base resolution\n\nMach-O dSYM companion files can carry an executable __TEXT segment with no file-backed bytes and a separate __DWARF segment at a different address. Selecting the first file-backed segment made every DWARF address appear below the image base, so the object silently produced no symbols.\n\nPrefer the __TEXT load command and fall back to the lowest non-page-zero mapped segment. Cover the parser and the HTTP Minidump plus Debug-ID path with an actual dSYM companion fixture, while retaining the ELF regression.",
publish	Build and publish both architectures	2026-10-21T06:04:19.6055070Z               "timestamp": "2026-10-21T05:57:36Z",
publish	Build and publish both architectures	2026-10-21T06:04:19.6055404Z               "tree_id": "98c850e91583bd553964fde756e444ce46467695"
