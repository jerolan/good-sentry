publish	Build and publish both architectures	2026-10-21T05:39:15.1246618Z             "display_title": "Symbolicate native ELF and Mach-O debug files",
publish	Build and publish both architectures	2026-10-21T05:39:15.1246823Z             "event": "push",
publish	Build and publish both architectures	2026-10-21T05:39:15.1246958Z             "head_branch": "main",
publish	Build and publish both architectures	2026-10-21T05:39:15.1247103Z             "head_commit": {
publish	Build and publish both architectures	2026-10-21T05:39:15.1247232Z               "author": {
publish	Build and publish both architectures	2026-10-21T05:39:15.1247392Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T05:39:15.1247579Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T05:39:15.1247721Z               },
publish	Build and publish both architectures	2026-10-21T05:39:15.1247836Z               "committer": {
publish	Build and publish both architectures	2026-10-21T05:39:15.1247998Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T05:39:15.1248178Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T05:39:15.1248316Z               },
publish	Build and publish both architectures	2026-10-21T05:39:15.1248456Z               "id": "e7448518d56098b513cb5bf8f36039d1243b3778",
publish	Build and publish both architectures	2026-10-21T05:39:15.1249910Z               "message": "Symbolicate native ELF and Mach-O debug files\n\nNative Minidumps could only use textual Breakpad symbols, leaving uploaded ELF and Mach-O objects unresolved. Those object formats also store preferred virtual addresses, so Minidump module-relative offsets must be normalized before lookup.\n\nParse both formats with the standard Go debug readers, retain DWARF function/file/line data, normalize image addresses, and match by a normalized Debug ID when the uploaded filename differs. Keep Breakpad and chunked DIF behavior as fallbacks.\n\nRace integration covers an authenticated ELF upload and a Minidump whose module name differs, resolving fixture_function with its source line and debug_id. Breakpad, DIF assembly and artifact-bundle tests remain green.",
publish	Build and publish both architectures	2026-10-21T05:39:15.1251488Z               "timestamp": "2026-10-21T05:33:05Z",
