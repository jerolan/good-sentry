publish	Build and publish both architectures	2026-10-21T05:39:15.1354552Z             "display_title": "Symbolicate native ELF and Mach-O debug files",
publish	Build and publish both architectures	2026-10-21T05:39:15.1354851Z             "event": "push",
publish	Build and publish both architectures	2026-10-21T05:39:15.1354986Z             "head_branch": "main",
publish	Build and publish both architectures	2026-10-21T05:39:15.1355129Z             "head_commit": {
publish	Build and publish both architectures	2026-10-21T05:39:15.1355262Z               "author": {
publish	Build and publish both architectures	2026-10-21T05:39:15.1355424Z                 "email": "11675668+jerolan@users.noreply.github.com",
