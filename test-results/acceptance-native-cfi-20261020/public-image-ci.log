publish	Build and publish both architectures	2026-10-21T06:37:02.6985991Z             "head_branch": "main",
publish	Build and publish both architectures	2026-10-21T06:37:02.6986246Z             "head_commit": {
publish	Build and publish both architectures	2026-10-21T06:37:02.6986486Z               "author": {
publish	Build and publish both architectures	2026-10-21T06:37:02.6986797Z                 "email": "11675668+jerolan@users.noreply.github.com",
