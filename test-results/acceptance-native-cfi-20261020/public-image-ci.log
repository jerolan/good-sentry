publish	Build and publish both architectures	2026-10-21T06:37:02.6987613Z               },
publish	Build and publish both architectures	2026-10-21T06:37:02.6987827Z               "committer": {
publish	Build and publish both architectures	2026-10-21T06:37:02.6988127Z                 "email": "11675668+jerolan@users.noreply.github.com",
publish	Build and publish both architectures	2026-10-21T06:37:02.6988473Z                 "name": "Jerome Olvera"
publish	Build and publish both architectures	2026-10-21T06:37:02.6988734Z               },
publish	Build and publish both architectures	2026-10-21T06:37:02.6988990Z               "id": "6dc6bd345ad75f51a4403b9749e746b6319bb914",
publish	Build and publish both architectures	2026-10-21T06:37:02.6990788Z               "message": "Retain every CFI table for a Debug ID\n\nA project can hold several debug files for the same Debug ID, such as ELF and dSYM objects. Storing one unwind table per key let older files overwrite the table that covered the crashing PC and silently truncated the CFI stack.\n\nKeep all candidate tables in load order and choose the first one with an FDE containing the current module-relative address. Add a regression where an empty candidate precedes the matching table.",
