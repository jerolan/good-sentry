publish	Build and publish both architectures	2026-10-21T06:37:02.7195937Z             "display_title": "Retain every CFI table for a Debug ID",
publish	Build and publish both architectures	2026-10-21T06:37:02.7196290Z             "event": "push",
publish	Build and publish both architectures	2026-10-21T06:37:02.7196542Z             "head_branch": "main",
publish	Build and publish both architectures	2026-10-21T06:37:02.7196799Z             "head_commit": {
publish	Build and publish both architectures	2026-10-21T06:37:02.7197035Z               "author": {
publish	Build and publish both architectures	2026-10-21T06:37:02.7197334Z                 "email": "11675668+jerolan@users.noreply.github.com",
